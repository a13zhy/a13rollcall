{
  "meta": {
    "id": "com.a13.sample",
    "name": "示例插件",
    "version": "1.2.0",
    "author": "A13",
    "description": "插件开发入门模板：读配置、弹提示、注册设置页的最小结构。1.2.0 补了 id 与权限声明，市场能正确认出已安装与更新。",
    "type": "general",
    "api_version": 1,
    "has_settings_page": true,
    "settings_page_title": "示例插件",
    "permissions": [
      "config",
      "ui"
    ],
    "min_app_version": "6.8",
    "max_app_version": "99.0",
    "repo": "https://github.com/a13zhy/a13rollcall"
  },
  "code": "# A13 示例插件 1.2.0\n# 插件需要定义 main(context)，context 提供 get_config / log_info / add_settings_page / on 等接口\n\ndef main(context):\n    cfg = context.get_config()\n    if not cfg.get('enabled', True):\n        return\n    context.log_info('示例插件已启动')\n    context.add_settings_page(\n        title='示例插件设置',\n        description='1.2.0：演示权限声明与设置页注册',\n        items=[\n            {'key': 'enabled', 'type': 'switch', 'label': '启用插件', 'default': True},\n            {'key': 'message', 'type': 'input', 'label': '提示消息', 'default': '你好'},\n        ]\n    )\n    context.on('draw_result', lambda name, text: context.log_info('抽到 ' + str(name)))\n    context.log_info('示例插件加载完成')\n",
  "config": {
    "enabled": true
  }
}